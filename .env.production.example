# Скопировать в .env.production на сервере и заполнить реальными значениями.
# docker-compose.prod.yml читает это через --env-file .env.production.

# --- CityHost MySQL ---
DB_HOST=venza.cityhost.com.ua
DB_PORT=3306
DB_NAME=ch65d751c9_p2panalytics
DB_USER=ch65d751c9_p2puser
DB_PASS=REPLACE_ME

# --- App auth ---
# bcrypt хэш пароля. Сгенерировать:
#   docker run --rm php:8.2-cli php -r "echo password_hash('your_password', PASSWORD_BCRYPT).PHP_EOL;"
# ВАЖНО: оборачивать значение в одинарные кавычки, иначе docker compose
# интерпретирует $ как ссылки на переменные и хэш съедается.
APP_PASSWORD_HASH='$2y$10$REPLACE_ME_WITH_REAL_HASH'

# --- Публичный порт ---
# Приложение будет доступно по http://135.181.254.225:WEB_PORT
WEB_PORT=8086